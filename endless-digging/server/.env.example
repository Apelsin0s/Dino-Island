# Steamworks → Users & Permissions → Manage Groups → Web API key (publisher key, keep it secret)
STEAM_WEB_API_KEY=
STEAM_APP_ID=
# your own SteamID64 (owner: ban, mute, announcements); several separated by commas
OWNER_STEAMIDS=
MAX_PLAYERS=1000
# development only: let people in without Steam
ALLOW_GUESTS=0
# a long random string: lets the maintainer read /api/admin/errors, /reports, /chat (Authorization: Bearer ...)
ADMIN_API_TOKEN=
